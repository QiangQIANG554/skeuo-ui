{
  "name": "skeuo-ui",
  "version": "1.0.4",
  "description": "Skeuo UI — 拟物风 Vue3 组件库",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "logo.svg"
  ],
  "main": "./dist/skeuo-ui.umd.cjs",
  "module": "./dist/skeuo-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/skeuo-ui.js",
      "require": "./dist/skeuo-ui.umd.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "gen:docs": "node scripts/gen-docs.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^5.0.3",
    "vitepress": "^1.6.4",
    "vue": "^3.4.0",
    "vue-tsc": "^2.1.0"
  },
  "keywords": [
    "vue3",
    "ui",
    "skeuomorphism",
    "neumorphism",
    "component-library"
  ],
  "dependencies": {
    "echarts": "^6.1.0",
    "qrcode-generator": "^2.0.4"
  }
}
